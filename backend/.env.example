# Use a random value in production.
SECRET_KEY=replace-with-a-secure-random-secret
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret

# Google OAuth 2.0 Client ID (Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Comma-separated browser origins allowed to call /api endpoints.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port for the Flask development server.
PORT=5000

# Local-first Ollama setup
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional fallback when Ollama is unavailable
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.6-flash

# Default initial public knowledge source.
UNIVERSITY_WEBSITE_URL=https://sangamuniversity.ac.in/
