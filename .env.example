# ==========================================
# ASK SANGAM - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. Security & Secrets (Generate secure random strings for production)
# e.g., run: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-in-production
JWT_EXPIRATION_HOURS=24

# 2. Google OAuth (Optional: for Google Login)
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=288291673778-u7cbjjafogp1gjpionp6cscf6ct81gu8.apps.googleusercontent.com

# 3. Google Gemini API (Recommended for Cloud / EC2 deployment)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_MODEL=gemini-3.6-flash

# 4. Local Ollama LLM (Optional: if running Ollama locally/on EC2 GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 5. Network & CORS Settings
PORT=5000
# Comma-separated list of allowed origins or '*' for wildcard
CORS_ORIGINS=*

# 6. University Knowledge Base Source
UNIVERSITY_WEBSITE_URL=https://sangamuniversity.ac.in/
